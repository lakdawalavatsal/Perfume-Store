# =================================================================
# MANGAALAM PERFUMES — Backend Environment Configuration
# =================================================================

# Server Port
PORT=5001

# Session & JWT Authentication
JWT_SECRET=mangaalam_luxury_secret_key_change_in_production_2026

# Note: Owner account is created privately via 'npm run admin:create' (never stored in .env)

# Supabase PostgreSQL Configuration (Persistent External Database)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local Fallback Database Storage Path (SQLite)
DB_PATH=./server/data/mangaalam.db

# Frontend CORS URL
CORS_ORIGIN=http://localhost:5180,http://localhost:5181

# Payment Configuration
ENABLE_COD=true
ENABLE_MANUAL_UPI=true
UPI_VPA=mangaalam@upi
UPI_MERCHANT_NAME="MANGAALAM Perfumes"

# Optional Future Online Payment Gateway Setup
# Supported values: manual | razorpay | stripe | phonepe
PAYMENT_GATEWAY_PROVIDER=manual
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
