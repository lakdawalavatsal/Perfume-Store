  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"magenta,cyan\" \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "admin:create": "node server/scripts/manage-admin.js create",
    "admin:reset": "node server/scripts/manage-admin.js reset-password",
    "admin:list": "node server/scripts/manage-admin.js list",
    "db:sync": "node server/scripts/sync-to-supabase.js",
    "db:sync:orders": "node server/scripts/sync-to-supabase.js --orders-only",
    "db:diagnose": "node server/scripts/diagnose-db.js",
    "db:status": "node -e \"import('./server/db/supabaseClient.js').then(m => m.testSupabaseConnection()).then(r => console.log(JSON.stringify(r, null, 2)))\""
  },
